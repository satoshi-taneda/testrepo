##########################################
# target server information
##########################################

Hostname     : {{ ansible_hostname }}
OS           : {{ ansible_distribution }}
Version      : {{ ansible_distribution_version }}
IPv4         : {{ ansible_default_ipv4.address }}
Architecture : {{ ansible_architecture }}

[Package Manager]

{% if ansible_distribution == "RedHat" %}
package_manager=yum
{% elif ansible_distribution == "Ubuntu" %}
package_manager=apt
{% else %}
package_manager=unknown
{% endif %}
Administrator: {{ administrator | default("未設定") }}

##########################################
# test
##########################################

{% set ips = ['MANAGEMENT_IP', 'BACKUP_IP', 'GYOMU_IP', 'DB_IP'] %}
{% set paths = ['DEVICE_PATH'] %}
{% set ips_count = ips | length %}
{# set paths_count = paths | length #}
{% for ip in ips %}
{% set i = loop.index0 %}
clpcfadm.py add hb lankhb {{ i }} {{ i }}
{% for SERVER in SERVERS %}
clpcfadm.py add device {{ SERVER.NAME }} lan {{ i }} {{ SERVER[ip] }}
{% endfor %}
{% endfor %}
{% for path in paths %}
{% set i = ips_count + loop.index0 %}
clpcfadm.py add hb lankhb {{ i }} {{ i }}
{% for SERVER in SERVERS %}
clpcfadm.py add device {{ SERVER.NAME }} lan {{ i }} {{ SERVER[path] }}
{% endfor %}
{% endfor %}


{% set gws_group = [['MANAGEMENT_GW', 'BACKUP_GW', 'GYOMU_GW', 'DB_GW']] %}
{% for gws in gws_group %}
{% set group_id = loop.index0 %}
{% set gws_count = gws | length %}
{% for gw in gws %}
{% set i = loop.index0 %}
{% set device_id = group_id * gws_count + i %}
clpcfset add np pingnp {{ device_id }} {{ device_id }} {{ group_id }} {{ i }} {{ GATEWAYS[group_id][gw] }}
{% for SERVER in SERVERS %}
clpcfadm.py add device {{ SERVER.NAME }} ping {{ device_id }} {{ SERVER.PING_NP_ENABLED }}
{% endfor %}
{% endfor %}
{% endfor %}


##########################################
# サーバグループ追加
##########################################
{#  サーバグループは使わない
{% for SG in SERVERGROUP %}
clpcfadm.py mod -t servergroup@{{ SG.NAME }}/comment --set "{{ SG.COMMENT }}" --nocheck
{% for ID in SG.SERVER_ID %}
clpcfadm.py mod -t servergroup@{{ SG.NAME }}/policy@{{ SERVERS[ID].NAME }}/order --set {{ loop.index0 }} --nocheck
{% endfor %}
{% endfor %}
