##########################################
# フェイルオーバ属性(拡張)
##########################################

clpcfadm.py mod -t group@failover1/autonomic/blacklist/use --set {{ VAR_failover_group_autonomic_blacklist_use }}
{% if VAR_failover_group_autonomic_blacklist_use == 1 %}
clpcfadm.py mod -t group@failover1/autonomic/functype/blacklist/target --set {{ FUNCTYPES | join(',') }}
clpcfadm.py mod -t group@failover1/autonomic/forcefo/use --set {{ VAR_failover_group_autonomic_forceto_use }}
{% endif %}

clpcfadm.py mod -t group@failover1/autonomic/functype/blacklist/targetgrp@0/rsc@{{ VAR_failover_group_functype_name }} --set "" --nocheck
clpcfadm.py mod -t group@failover1/failback --set {{ VAR_failover_group_failback }}















